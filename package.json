{
  "name": "mymis-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/server.js",
    "mock-db": "json-server mock-data/db.json --port 3001",
    "redis:start": "docker start my-redis 2>nul || docker run --name my-redis -p 6379:6379 -d redis",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\" \"npm run mock-db\" \"npm run redis:start\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest --watch=false",
    "test:watch": "vitest",
    "lint": "eslint src --ext ts,tsx"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@hookform/resolvers": "^5.7.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/system": "^9.2.0",
    "@tanstack/react-query": "^4.19.0",
    "@tanstack/react-table": "^8.7.0",
    "axios": "^1.7.4",
    "jwt-decode": "^4.0.0",
    "libphonenumber-js": "^1.13.14",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "mui-modal-provider": "^2.4.4",
    "mui-tel-input": "^11.0.0",
    "notistack": "^3.0.1",
    "react": "^18.2.0",
    "react-country-flag": "^3.1.0",
    "react-custom-scrollbars-2": "^4.5.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.2.0",
    "react-easy-crop": "^5.1.0",
    "react-hook-form": "^7.85.0",
    "react-router-dom": "^7.18.2",
    "redis": "^6.0.0",
    "zod": "^4.4.3",
    "zustand": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@types/lodash": "^4.17.13",
    "@types/node": "^24.0.0",
    "@types/react": "^18.0.24",
    "@types/react-datepicker": "^4.4.1",
    "@types/react-dom": "^18.0.8",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^5.44.0",
    "@typescript-eslint/parser": "^5.44.0",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.3",
    "eslint": "^8.2.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-typescript": "^3.5.2",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "jsdom": "^20.0.3",
    "json-server": "^1.0.0-beta.15",
    "msw": "^2.6.5",
    "prettier": "^2.8.0",
    "typescript": "^5.9.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
